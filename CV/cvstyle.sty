\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cvstyle}[2026/01/01 minimal ATS-friendly CV style]

\RequirePackage[a4paper, margin=1.3cm, top=1.0cm, bottom=1.0cm]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage{xcolor}
\RequirePackage{titlesec}
\RequirePackage{enumitem}
\RequirePackage{graphicx}
\RequirePackage[hidelinks]{hyperref}

\definecolor{accent}{HTML}{1F3A5F}
\definecolor{subtext}{HTML}{444444}

\pagestyle{empty}
\setlength{\parindent}{0pt}
\raggedbottom

\titleformat{\section}{\large\bfseries\color{accent}}{}{0pt}{}[{\color{accent}\rule{\linewidth}{0.9pt}}]
\titlespacing{\section}{0pt}{5pt}{2pt}

\setlist[itemize]{leftmargin=11pt, itemsep=0pt, topsep=0pt, parsep=0pt, partopsep=0pt}

\newcommand{\cvname}[1]{{\fontsize{22}{24}\selectfont\bfseries #1}}
\newcommand{\cvrole}[1]{{\color{subtext}\large #1}}
\newcommand{\cvdate}[1]{{\color{subtext}\small\itshape #1}}

% \cventry{Title}{Place}{Dates}
\newcommand{\cventry}[3]{%
  \par\noindent\textbf{#1} \\
  {\small\color{subtext}#2 \hfill \cvdate{#3}}\par\vspace{1pt}
}

\newcommand{\cvproject}[2]{%
  \par\noindent\textbf{#1} \hfill \cvdate{#2}\par
}

\endinput
